# Copy this file to .env and fill private credentials.
# Never commit .env or paste its contents into logs.

# Default WebRTC path: microphone -> Pipecat SmallWebRTC -> local barge-in VAD
# -> native Qwen Audio S2S -> DyStream -> Pipecat SmallWebRTC. The preserved
# MSE path remains available through scripts/run_demo.sh for controlled A/B.
PIPECAT_WEBRTC_DIALOG_MODE=native_s2s
# Formal MSE demo switch. Keep native_s2s until custom_cascade passes the
# documented A/B acceptance test; rollback is one environment-file change.
PIPECAT_MSE_DIALOG_MODE=native_s2s
PIPECAT_BARGE_IN_CONFIDENCE=0.65
PIPECAT_BARGE_IN_START_SEC=0.12
PIPECAT_BARGE_IN_STOP_SEC=0.20
PIPECAT_BARGE_IN_MIN_VOLUME=0.50
PIPECAT_S2S_API_KEY=
# Preferred production route: set the Beijing workspace id, or the complete
# regional MAAS WebSocket URL. If both stay blank, the provider uses the
# DashScope compatibility endpoint (live-verified with Qwen-Audio 3.0).
PIPECAT_S2S_WORKSPACE_ID=
PIPECAT_S2S_BASE_URL=
PIPECAT_S2S_MODEL=qwen-audio-3.0-realtime-flash
PIPECAT_S2S_VOICE=longanqian
# Supported: smart_turn (recommended) or server_vad. Manual mode is not
# implemented because this path intentionally relies on provider turn events.
PIPECAT_S2S_TURN_DETECTION=smart_turn
# Used only when PIPECAT_S2S_TURN_DETECTION=server_vad. The default smart_turn
# path ignores this value; 500 ms remains the documented low-latency fallback.
PIPECAT_S2S_VAD_SILENCE_MS=500
PIPECAT_S2S_VAD_THRESHOLD=0.5
PIPECAT_S2S_MAX_HISTORY_TURNS=10
PIPECAT_S2S_MIC_QUEUE_MAX_CHUNKS=3
PIPECAT_S2S_MIC_SEND_TIMEOUT_SEC=1.0
PIPECAT_S2S_CONNECT_TIMEOUT_SEC=8
PIPECAT_S2S_RECONNECT_INITIAL_SEC=0.5
PIPECAT_S2S_RECONNECT_MAX_SEC=8
PIPECAT_S2S_PING_INTERVAL_SEC=20
PIPECAT_S2S_PING_TIMEOUT_SEC=20
PIPECAT_SYSTEM_INSTRUCTION=你是一个友好、自然的中文语音助手。完整回答用户的问题，不要为了追求首声速度截断答案。

# Compatibility only: an existing DashScope key stored here is reused when
# PIPECAT_S2S_API_KEY is blank. Set PIPECAT_WEBRTC_DIALOG_MODE=cascade only
# for an A/B comparison with the old ASR -> LLM -> TTS route.
PIPECAT_LLM_API_KEY=
PIPECAT_LLM_BASE_URL=
PIPECAT_LLM_MODEL=
PIPECAT_LLM_ENABLE_THINKING=false
# Real-time public web information through DashScope's built-in search.
# off=rollback default, smart=local fast router, auto=provider decides, always=force.
PIPECAT_REALTIME_SEARCH_MODE=off
PIPECAT_REALTIME_SEARCH_STRATEGY=turbo
# Optional lower-latency model used only for live-search turns.
PIPECAT_REALTIME_SEARCH_MODEL=

# Used only by PIPECAT_MSE_DIALOG_MODE=custom_cascade.
# The official 600 ms Paraformer streaming chunk is the safe baseline; 0,8,4
# (480 ms) can be A/B tested after recognition accuracy is verified.
PIPECAT_ASR_MODEL=paraformer-zh-streaming
PIPECAT_ASR_DEVICE=cpu
PIPECAT_ASR_HUB=ms
# Leave blank here; scripts/flashav2av exports the same persistent cache used by
# setup and the running service from FLASHAV2AV_DATA_ROOT.
MODELSCOPE_CACHE=
PIPECAT_ASR_CHUNK_SIZE=0,10,5
PIPECAT_ASR_ENCODER_CHUNK_LOOK_BACK=4
PIPECAT_ASR_DECODER_CHUNK_LOOK_BACK=1
# Idle audio never enters Paraformer. Keep enough PCM to recover the speech
# used by Silero to confirm VAD start; runtime clamps this to at least START_SEC.
PIPECAT_ASR_PRE_ROLL_SEC=0.30
PIPECAT_USER_SPEECH_TIMEOUT_SEC=0.45
PIPECAT_USER_TURN_STOP_TIMEOUT_SEC=2.0
VOXCPM2_BRIDGE_URI=ws://127.0.0.1:8770
VOXCPM2_CONNECT_TIMEOUT_SEC=45
# Put these in the isolated bridge env. A non-empty warmup text moves the
# Nano/CUDA first-request cost before the bridge reports ready.
VOXCPM2_WARMUP_TEXT=hello.
VOXCPM2_WARMUP_TIMEOUT_SEC=120
# Disabled by default. When enabled, discard only a confidently detected
# generated-silence prefix while preserving 40 ms before the first speech.
VOXCPM2_LEADING_TRIM_ENABLED=0
VOXCPM2_LEADING_TRIM_DBFS=-60.0
VOXCPM2_LEADING_TRIM_CONFIRM_MS=20
VOXCPM2_LEADING_TRIM_PREROLL_MS=40
VOXCPM2_LEADING_TRIM_MAX_SCAN_MS=320

# Dual-GPU assignment. These are logical ids after CUDA_VISIBLE_DEVICES.
CUDA_VISIBLE_DEVICES=0,1
MOTION_GPU=0
RENDER_GPU=1

# Optional local avatar override. Default: the exact Listener frame-zero anchor.
DYSTREAM_REF_IMAGE=

# MSE and continuous official DyStream idle inference.
PORT=7860
PIPE_FRAME_STRIDE=1
PIPE_GOP=3
SEGMENT_FRAMES=4
# 512x512 H.264 quality. The old 1800k/3600k path is the instant rollback;
# 4000k/8000k removes most encoder loss without pretending to add model detail.
FFMPEG_VIDEO_BITRATE=4000k
FFMPEG_VIDEO_BUFSIZE=8000k
ENGINE_IDLE_WARMUP_SEGMENTS=16
ENGINE_IDLE_CONTINUOUS=1
ENGINE_IDLE_VISIBLE=1
ENGINE_IDLE_ONLY_WITH_CLIENT=1
ENGINE_IDLE_COMPACT_SEGMENTS=40
DYSTREAM_AUDIO_HISTORY_KEEP_SEC=4.0
# Log mode changes, slow hops, and every Nth healthy hop to avoid hot-loop I/O.
DYSTREAM_LIVE_LOG_EVERY=5
# Keep the same recurrent DyStream stream alive while listening by feeding the
# prepared Listener conditioning WAV into audio_other. Browser microphone audio
# remains owned by the dialogue pipeline and is never sent to avatar motion.
# Listener conditioning is private identity media and is not distributed.
# Set both fields in the private env only after supplying an authorized WAV.
ENGINE_LISTENER_AUDIO=0
ENGINE_LISTENER_VIRTUAL_AUDIO=
# Ordinary barge-in stays on one FFmpeg/MSE timeline. A hard encoder epoch is
# now reserved for genuine encoder/backlog recovery.
ENGINE_TTS_STREAM_RESET=0
# Preserve one continuous generation on barge-in and let the next unconsumed
# assistant samples fade naturally to zero before returning to Listener.
ENGINE_INTERRUPT_GRACE_SEC=0.40
# Compatibility fallback used only when ENGINE_INTERRUPT_GRACE_SEC is unset.
ENGINE_INTERRUPT_BRIDGE_SEC=0.20
# Keep already-rendered assistant media interruptible while it drains through
# GPU queues, ffmpeg, network, and the browser MSE target buffer.
ENGINE_ASSISTANT_MEDIA_DRAIN_SEC=1.2

# Keep experimental hand-written listening controls disabled. Silence/listening
# is generated by the official DyStream inference path.
DYSTREAM_LISTENING_CONTROLLER=0
DYSTREAM_LISTENING_CONTROLLER_DEBUG=0
DYSTREAM_LISTENING_FACE_CONTROL=0
DYSTREAM_LISTENING_NOD=0
DYSTREAM_LISTENING_BLINK=0
DYSTREAM_LISTENING_FACE_CONTROL_DEBUG=0

# Legacy SeedDuplex values are retained only for the old backend and are not
# required by scripts/run_demo.sh.
SEEDUPLEX_APP_ID=
SEEDUPLEX_ACCESS_KEY=
SEEDUPLEX_WS_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
SEEDUPLEX_APP_KEY=
SEEDUPLEX_RESOURCE_ID=volc.speech.dialog
SEEDUPLEX_SPEAKER=zh_female_vv_jupiter_bigtts
SEEDUPLEX_MODEL=1.2.1.1
SEEDUPLEX_END_SMOOTH_MS=1500
