# Add source configs/infra_20786.env.example at the END of the private .env
# produced by scripts/flashav2av configure --single-gpu. Run from repo root.
# Model files, reference voice, portrait, GPU assignment and credentials come
# from that private deployment configuration.
PIPECAT_MSE_DIALOG_MODE=custom_cascade
PIPECAT_LLM_MODEL=qwen3.6-flash
PIPECAT_LLM_ENABLE_THINKING=false
PIPECAT_LLM_MAX_SENTENCES=0
PIPECAT_REALTIME_SEARCH_MODE=off
PIPECAT_ASR_PRE_ROLL_SEC=0.60
PIPECAT_BARGE_IN_CONFIDENCE=0.65
PIPECAT_BARGE_IN_START_SEC=0.12
PIPECAT_BARGE_IN_STOP_SEC=0.45
PIPECAT_BARGE_IN_MIN_VOLUME=0.50
PIPECAT_USER_SPEECH_TIMEOUT_SEC=0.65
PIPECAT_USER_TURN_STOP_TIMEOUT_SEC=2.0
PIPECAT_SYSTEM_INSTRUCTION='你是一个友好、自然的中文语音助手。用自然口语直接、简洁、完整地回答问题。讲故事时直接讲出故事，要有开端、事件和结局，不要只答应、报标题或只说开场白。未指定长度时讲约150字的完整短故事，用户指定更长内容时按要求展开。解释、步骤等任务也要给出完整内容，不要为了追求首声速度或三句限制截断答案。不要使用Markdown、列表或序号，最后一句必须完整。只在当前问题要求自我介绍时介绍自己。一次对话中，讲故事请直接从情节开始；前一轮被打断时优先回应最新问题。'
PIPE_FRAME_STRIDE=1
PIPE_GOP=3
SEGMENT_FRAMES=4
DYSTREAM_FOLD_EMA=1
DYSTREAM_PRUNE_CFG=0
DYSTREAM_CACHE_SPECTRAL_NORM=1
DYSTREAM_RELEASE_RENDER_INTERMEDIATES=1
DYSTREAM_AUDIO_HISTORY_MAX_SEC=0
DYSTREAM_LISTENING_CONTROLLER=0
DYSTREAM_LISTENING_FACE_CONTROL=0
DYSTREAM_AUDIO_Q=8
DYSTREAM_MOTION_Q=4
DYSTREAM_FRAME_Q=20
ENGINE_LISTENER_AUDIO=0
ENGINE_IDLE_CONTINUOUS=1
ENGINE_IDLE_VISIBLE=1
ENGINE_IDLE_ONLY_WITH_CLIENT=1
ENGINE_IDLE_INFLIGHT_HIGH_WATER_SEC=0.32
ENGINE_IDLE_AUDIO_Q_MAX=1
ENGINE_IDLE_MOTION_Q_MAX=1
ENGINE_IDLE_FRAME_Q_MAX=8
ENGINE_ASSISTANT_MEDIA_DRAIN_SEC=1.2
ENGINE_INTERRUPT_GRACE_SEC=0.40
ENGINE_INTERRUPT_BRIDGE_SEC=0.20
ENGINE_TTS_STREAM_RESET=0
VOXCPM2_LEADING_TRIM_ENABLED=0
