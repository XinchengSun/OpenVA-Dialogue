# Copy outside Git, chmod 600, and point run_openai_speech_bridge.sh at it.
# To manage 8771 and 8772 side by side, prefix lifecycle commands with
# OPENAI_SPEECH_INSTANCE=single or OPENAI_SPEECH_INSTANCE=dual.  The instance
# belongs to the lifecycle command, not this private environment file.
FLASHAV2AV_ROOT=${FLASHAV2AV_ROOT:-$HOME/FlashAV2AV}
OPENAI_SPEECH_PYTHON=$HOME/.venvs/flashav2av/bin/python
OPENAI_SPEECH_BRIDGE_HOST=127.0.0.1
OPENAI_SPEECH_BRIDGE_PORT=8771

# SGLang-Omni Fish Speech S2 Pro candidate server.
OPENAI_SPEECH_BASE_URL=http://127.0.0.1:8000
OPENAI_SPEECH_HEALTH_PATH=/health
OPENAI_SPEECH_ENDPOINT=/v1/audio/speech
OPENAI_SPEECH_PROVIDER=sglang
OPENAI_SPEECH_MODEL=fishaudio/s2-pro
OPENAI_SPEECH_VOICE=default
OPENAI_SPEECH_SAMPLE_RATE=44100

# Use a clean 10-20 second single-speaker clip and its exact transcript.
OPENAI_SPEECH_REFERENCE_AUDIO=$FLASHAV2AV_ROOT/assets/reference.wav
OPENAI_SPEECH_REFERENCE_TEXT=准确的参考音频逐字稿。

# Optional SGLang tuning fields. A fixed seed keeps repeated per-sentence Fish
# requests deterministic without changing temperature, chunking, or first-audio
# latency. Remove the seed only when deliberately testing stochastic voices.
OPENAI_SPEECH_EXTRA_BODY_JSON='{"seed":20260811}'
OPENAI_SPEECH_WARMUP_TEXT=你好，这是一条预热语音。
OPENAI_SPEECH_REQUEST_TIMEOUT_SEC=120
OPENAI_SPEECH_CONNECT_TIMEOUT_SEC=10

# Only required for an authenticated remote OpenAI-compatible endpoint.
OPENAI_SPEECH_API_KEY=
